# =============================================================================
# XWallet — Branding & Configuration
# =============================================================================
# This file provides 100% customization of the app's name, colors, logo,
# typography, and external service connections. Modify any value below to
# rebrand or reconfigure the entire application.
# =============================================================================

# ── Brand Identity ────────────────────────────────────────────────────────────
APP_NAME=XWallet
APP_DESCRIPTION=Secure Digital Asset Wallet
# APP_URL=http://207.189.0.231:5173
APP_URL=https://stunning-goldfish-4q79qrjj5q472744-5173.app.github.dev/

# ── Logo (path relative to ./app/public/) ────────────────────────────────────
LOGO_PATH=/logo.svg
LOGO_ALT=XWallet Logo

# ── Color Palette (Tailwind color names or RGB values) ──────────────────────
# Primary: used for buttons, links, active states
PRIMARY_COLOR=indigo-600
PRIMARY_COLOR_RGB=79 70 229

# Primary hover state
PRIMARY_HOVER_COLOR=indigo-700
PRIMARY_HOVER_COLOR_RGB=67 56 202

# Secondary: card backgrounds, sidebar, surfaces
SECONDARY_COLOR=slate-800
SECONDARY_COLOR_RGB=30 41 59

# Accent: highlights, badges, secondary actions
ACCENT_COLOR=blue-500
ACCENT_COLOR_RGB=59 130 246

# Status colors
SUCCESS_COLOR=green-500
WARNING_COLOR=yellow-500
DANGER_COLOR=red-500

# Background (page-level)
BACKGROUND_COLOR=slate-900
BACKGROUND_COLOR_RGB=15 23 42

# Surface (cards, modals, panels)
SURFACE_COLOR=slate-800
SURFACE_COLOR_RGB=30 41 59

# Elevated surface (dropdowns, tooltips)
SURFACE_ELEVATED_COLOR=slate-700
SURFACE_ELEVATED_COLOR_RGB=51 65 85

# Border color
BORDER_COLOR=slate-700
BORDER_COLOR_RGB=51 65 85

# Text colors
TEXT_PRIMARY_COLOR=slate-100
TEXT_PRIMARY_COLOR_RGB=241 245 249
TEXT_SECONDARY_COLOR=slate-400
TEXT_SECONDARY_COLOR_RGB=148 163 184

# ── Typography ───────────────────────────────────────────────────────────────
FONT_FAMILY=Inter, system-ui, sans-serif
FONT_MONO=JetBrains Mono, Fira Code, monospace

# ── Ethereum / Blockchain ───────────────────────────────────────────────────
# RPC URL for live balance fetching and transaction broadcast
# Replace with your own Infura/Alchemy/QuickNode endpoint
RPC_URL=https://mainnet.infura.io/v3/YOUR-PROJECT-ID

# Chain ID (1 = Ethereum Mainnet, 11155111 = Sepolia testnet)
CHAIN_ID=1

# Block explorer URL (for transaction links)
EXPLORER_URL=https://etherscan.io

# Ethereum unit label
ASSET_SYMBOL=ETH
ASSET_NAME=Ethereum
ASSET_DECIMALS=18

# ── PocketBase ──────────────────────────────────────────────────────────────
# URL where PocketBase is running (local dev or deployed)
# POCKETBASE_URL=http://207.189.0.231:8090
POCKETBASE_URL=http://207.189.0.231:8090

# ── Open Graph / SEO ────────────────────────────────────────────────────────
OG_TITLE=XWallet — Secure Digital Asset Wallet
OG_DESCRIPTION=Take control of your digital assets with XWallet. A modern, secure wallet for Ethereum.
OG_IMAGE=/og-image.png



